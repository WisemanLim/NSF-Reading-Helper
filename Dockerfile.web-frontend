# syntax=docker/dockerfile:1.7
# Frontend image — builds the Vite/React SPA and serves it with nginx,
# reverse-proxying /api/ to the backend container.
FROM node:20-bookworm-slim AS builder
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --no-frozen-lockfile

COPY index.html postcss.config.js tailwind.config.js tsconfig.json tsconfig.node.json vite.config.ts ./
COPY public ./public
COPY src ./src

ARG VITE_NSF_API_BASE=""
ENV VITE_NSF_API_BASE=${VITE_NSF_API_BASE}
RUN pnpm build


FROM nginx:1.27-alpine AS runtime
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx.app.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
