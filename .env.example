# Copy to `.env` (next to docker-compose.yml) and fill in.
# `.env` is loaded automatically by `docker compose`.

# Public hostname the site responds on. Must point to this server's public IP
# (A / AAAA records) before bringing the stack up — acme-companion runs an
# HTTP-01 challenge during the first `docker compose up`.
DOMAIN=nsf-reading.example.com

# Contact address Let's Encrypt uses for renewal notices.
LETSENCRYPT_EMAIL=admin@example.com

# Max upload size at the edge (mostly irrelevant — NSF doesn't ingest media).
CLIENT_MAX_BODY_SIZE=32m

# Backend log level: info, debug, warn.
RUST_LOG=info

# Postgres (production only — `docker-compose.yml`). Change the password!
POSTGRES_DB=nsf
POSTGRES_USER=nsf
POSTGRES_PASSWORD=please-change-this-strong-secret

# Optional OCR sidecar tuning.
OCR_LOG_LEVEL=INFO
OCR_PRELOAD=0
