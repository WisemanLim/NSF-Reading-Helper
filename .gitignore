# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# JS / frontend
node_modules
dist
dist-ssr
*.local

# Rust / Tauri
src-tauri/target
src-tauri/Cargo.lock.merge
src-tauri/WixTools*
src-tauri/gen/schemas
src-tauri/.omc/**

# Rust / web-server (axum)
web-server/target
web-server/Cargo.lock.merge
web-server/.dev-data/
web-server/*.sqlite*
web-server/.env
web-server/.env.*
web-server/data/
web-server/.omc/**

# OCR sidecar (Python)
ocr/__pycache__/
ocr/.venv/
ocr/.pytest_cache/
ocr/.mypy_cache/
ocr/.cache/
ocr/*.egg-info/
*.pyc

# Docker / runtime data (host-side persistence dirs if mapped locally)
data/
pgdata/
ocr-cache/
icons-source.png

# Code-signing / secrets (do NOT commit)
*.p12
*.pfx
*.keystore
.tauri/*.key
.tauri/*.key.pub

# App data accidentally committed
models/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.omc/**
.claude/**

# macOS code signing artifacts
*.mobileprovision
*.provisionprofile
